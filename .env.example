# Выпустите отдельный токен в Т-Бизнесе с минимальными правами:
# - информация о счетах компании;
# - информация об операциях компании;
# - создание черновиков платежей (только если нужны черновики).
TBANK_API_TOKEN=

# По умолчанию используется production API.
# Укажите адрес тестовой среды только если он выдан/подтвержден Т-Банком.
# TBANK_API_BASE_URL=https://business.tbank.ru/openapi/api

# Необязательно: путь к пользовательскому CA bundle вместо системного хранилища.
# TBANK_CA_BUNDLE=

# Ограничение размера ответа выписки на один вызов MCP.
TBANK_STATEMENT_MAX_LIMIT=5000
